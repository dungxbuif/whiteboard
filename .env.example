HTTP_ADDR=:8080
HTTP_PORT=8080

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dev
POSTGRES_PASSWORD=password
POSTGRES_DB=devtool
DATABASE_URL=postgres://test:test@127.0.0.1:5432/whiteboard_test?sslmode=disable

MINIO_ENDPOINT=storage.example.com
MINIO_ENDPOINT_URL=https://storage.example.com
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=<minio-access-key>
MINIO_SECRET_KEY=<minio-secret-key>
MINIO_BUCKET_NAME=whiteboard-sandbox
MINIO_API=s3v4
MINIO_PATH_STYLE=auto

S3_ENDPOINT_URL=https://storage.example.com
S3_ACCESS_KEY_ID=<s3-access-key>
S3_SECRET_ACCESS_KEY=<s3-secret-key>
S3_BUCKET=whiteboard-sandbox
S3_SIGNATURE_VERSION=s3v4
S3_PATH_STYLE=auto
AWS_ACCESS_KEY_ID=<aws-access-key>
AWS_SECRET_ACCESS_KEY=<aws-secret-key>
AWS_REGION=us-east-1
