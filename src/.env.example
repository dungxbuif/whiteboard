HTTP_ADDR=:8080

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dev
POSTGRES_PASSWORD=password
POSTGRES_DB=devtool
DATABASE_URL=postgres://test:test@127.0.0.1:5432/whiteboard_test?sslmode=disable

MINIO_ENDPOINT=storage.example.com
MINIO_ENDPOINT_URL=https://storage.example.com
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=<minio-access-key>
MINIO_SECRET_KEY=<minio-secret-key>
MINIO_BUCKET_NAME=whiteboard-sandbox
MINIO_API=s3v4
MINIO_PATH_STYLE=auto

S3_ENDPOINT_URL=https://storage.example.com
S3_ACCESS_KEY_ID=<s3-access-key>
S3_SECRET_ACCESS_KEY=<s3-secret-key>
S3_BUCKET=whiteboard-sandbox
S3_SIGNATURE_VERSION=s3v4
S3_PATH_STYLE=auto
AWS_ACCESS_KEY_ID=<aws-access-key>
AWS_SECRET_ACCESS_KEY=<aws-secret-key>
AWS_REGION=us-east-1

JWT_SECRET=test-jwt-secret-minimum-32-bytes-long
# Dedicated v2 room/session signer, >=32 bytes and different from JWT_SECRET.
COLLAB_JWT_SECRET=test-jwt-secret-minimum-32-bytes-long
CASBIN_MODEL_PATH=configs/casbin_model.conf
# Password login is managed with the backend userctl CLI.
FRONTEND_URL=http://localhost:5173

# External Coturn relay on the Homelab gateway. TURN_AUTH_SECRET must match the
# VPS-only coturn secret and is used to mint short-lived browser credentials.
TURN_URL=turn:turn.relayhub.dungxbuif.com:5349
TURN_USERNAME=whiteboard
TURN_PASSWORD=
TURN_AUTH_SECRET=<same-as-coturn-static-auth-secret>
TURN_REALM=turn.relayhub.dungxbuif.com
TURN_MIN_PORT=49152
TURN_MAX_PORT=49252

# Optional OpenAI-compatible AI proxy configuration. DeepSeek is the default.
AI_API_KEY=<deepseek-api-key>
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL_FAST=deepseek-chat
AI_MODEL_REASONING=deepseek-reasoner

# Leave unset for local development; Vite proxies /api to the Go backend.
VITE_API_URL=

# Private Go mutation authority; distinct >=32-byte secrets, shared with collab only.
AUTHORITY_SERVICE_SECRET=replace-with-unique-random-service-secret
MUTATION_GRANT_SECRET=replace-with-unique-random-grant-secret
# Explicit loopback/private address; never publish/proxy this listener publicly.
AUTHORITY_LISTEN_ADDR=127.0.0.1:8081

# MCP service (agent keys belong in protected client config, never this file)
WHITEBOARD_API_URL=http://127.0.0.1:8080
MCP_ALLOWED_ORIGINS=http://localhost:5173
MCP_BIND_HOST=127.0.0.1
# MCP uses PORT=3002 by default; deployments set it on the MCP service only.
# Required for HTTP startup: absolute persistent path, unique to each MCP process.
# Mount its directory on durable storage and collect rotated journals.
MCP_AUDIT_PATH=/var/lib/whiteboard-mcp/audit.jsonl
