# HTTP adapter; backend may be private, but URLs returned to users must be public.
WHITEBOARD_API_URL=http://127.0.0.1:8080
WHITEBOARD_PUBLIC_URL=https://whiteboard.example.com
MCP_AUDIT_PATH=/var/lib/whiteboard-mcp/audit.jsonl
MCP_ALLOWED_ORIGINS=https://whiteboard.example.com
MCP_BIND_HOST=127.0.0.1
PORT=3002
# Stdio clients: set both WHITEBOARD_API_URL and WHITEBOARD_PUBLIC_URL to the
# public frontend origin; WHITEBOARD_AGENT_KEY is their own scoped key. Never distribute internal service/grant secrets.
